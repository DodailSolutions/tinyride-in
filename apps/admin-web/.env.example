# ==============================================================================
# TinyRide Admin Web — Production & Local Environment Configuration
# ==============================================================================

# 1. Base Application URL
NEXT_PUBLIC_APP_URL=https://tinyride.in

# 2. Supabase Cloud Configuration (Required)
# NOTE: SUPABASE_SERVICE_ROLE_KEY is strictly server-only. NEVER prefix with NEXT_PUBLIC_!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. Session Security
# HMAC secret for signing role-scoped session tokens. (Defaults to SUPABASE_SERVICE_ROLE_KEY if unset)
SESSION_SECRET=a-secure-random-64-character-hex-string

# 4. Map Provider Configuration
# Supported: osm | mapbox | maptiler | carto
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_CARTO_API_KEY=

# 5. Twilio SMS Gateway (Optional if using Supabase Auth Email flow)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 6. Production Safety Flags
# In production, both MUST remain false
DEMO_MODE=false
DEV_OTP_BYPASS=false

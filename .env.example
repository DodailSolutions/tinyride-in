# ==============================================================================
# TinyRide — Production & Local Environment Configuration
# ==============================================================================

# 1. Base Application URL
NEXT_PUBLIC_APP_URL=https://tinyride.in

# 2. Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# 3. PostgreSQL Direct Database Connection (Optional for CLI migrations)
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# 4. Map Provider Configuration
# Supported providers:
#   osm       - OpenStreetMap (Standard high-availability tiles, no API key required)
#   mapbox    - Mapbox Vector/Raster tiles (Requires NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN)
#   maptiler  - MapTiler Cloud tiles (Requires NEXT_PUBLIC_MAPTILER_API_KEY)
#   carto     - CartoDB / Stadia tiles (Requires NEXT_PUBLIC_CARTO_API_KEY)
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_CARTO_API_KEY=

# 5. SMS / OTP Dispatch Gateway (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# 6. Operational Feature Flags & Environment Modes
# In production, DEMO_MODE must always be false
DEMO_MODE=false

# In production, DEV_OTP_BYPASS must always be false
DEV_OTP_BYPASS=false

# Session HMAC signing secret (uses SUPABASE_SERVICE_ROLE_KEY if not specified)
SESSION_SECRET=
